# Advisora - Environment Variables Configuration
# Copy this file to .env.local for local development

# Supabase Project URL (from your Supabase Project Settings -> API)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anon Key (public client key with RLS protection)
# IMPORTANT: Never include service_role secret keys in client-side applications!
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
